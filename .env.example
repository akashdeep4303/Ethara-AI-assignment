# ─── Fastest fix (Mac/Linux with local Postgres): ─────────────────────────
# brew services start postgresql@16
# npm run setup:local
#
# ─── Local Docker ────────────────────────────────────────────────────────
# docker compose up -d   then use:
# DATABASE_URL="postgresql://ethara:ethara@localhost:5432/ethara?schema=public"

# ─── Manual Homebrew Postgres (same user, no password) ───────────────────
# createdb ethara
DATABASE_URL="postgresql://YOUR_USERNAME@localhost:5432/ethara?schema=public"

# ─── Docker match (docker-compose.yml) ─────────────────────────────────
# DATABASE_URL="postgresql://ethara:ethara@localhost:5432/ethara?schema=public"

# ─── Or: cloud / Railway ─────────────────────────────────────────────────
# Railway: add the Postgres plugin and copy DATABASE_URL from the database service.
# Many hosts need SSL, e.g. ?schema=public&sslmode=require

# ─── Auth (required in production) ──────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string-in-production"

# Optional (default "7d")
# JWT_EXPIRES="7d"
